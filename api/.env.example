# Banco de Dados (PostgreSQL)
POSTGRES_DB=sfha_db
POSTGRES_USER=sfha
POSTGRES_PASSWORD=sfha

# Overrides de hostname Docker (substitui os valores localhost do api/.env)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# JWT
SECRET_KEY=troque-por-uma-string-aleatoria-longa-e-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS — origem permitida para o frontend
CORS_ORIGIN=http://localhost:4200

# LGPD — salt para pseudonimização de CPF (SHA-256)
SECRET_SALT=troque-por-uma-string-aleatoria-longa-e-segura

# Azure AI Speech (Speech-to-Text)
# Obtenha em: portal.azure.com > Azure AI services > Speech service > Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure AI Language (Text Analytics — análise de sentimento)
# Obtenha em: portal.azure.com > Azure AI services > Language service > Keys and Endpoint
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# Azure OpenAI (análise clínica multimodal)
# Obtenha em: portal.azure.com > Azure OpenAI > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-04-14

# Azure Blob Storage (áudio temporário durante análise — container: casf-audio-temp)
# Obtenha em: portal.azure.com > Storage Account > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Celery + Redis (fila de análises assíncronas)
CELERY_BROKER_URL=redis://localhost:6379/0
