# =============================================================================
# sus-female-healthcare-assistant — .env da raiz (Docker Compose)
# Copie para .env e ajuste os valores. Config dos serviços Azure fica em api/.env
# =============================================================================

# PostgreSQL — consumido pelo service 'db'
POSTGRES_DB=sfha_db
POSTGRES_USER=sfha
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE

# Overrides de hostname Docker (substitui os valores localhost do api/.env)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
CELERY_BROKER_URL=redis://sfha_redis:6379/0
