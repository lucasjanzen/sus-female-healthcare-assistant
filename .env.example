# =============================================================================
# sus-female-healthcare-assistant — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# =============================================================================

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql://sfha:sfha@db:5432/sfha_db

# JWT
SECRET_KEY=troque-por-uma-string-aleatoria-longa-e-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS — origem permitida para o frontend
CORS_ORIGIN=http://localhost:4200
